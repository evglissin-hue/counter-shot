{
  "name": "counter-shot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Keepfall (working title): a physics-heavy 3D castle duel for the browser.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "lab"
  ],
  "scripts": {
    "check": "node tools/check-boundaries.mjs && npm run typecheck && node tools/run-tests.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node tools/run-tests.mjs",
    "lab:dev": "npm run dev -w @counter-shot/lab",
    "lab:build": "npm run build -w @counter-shot/lab",
    "game:dev": "npm run dev -w @keepfall/game",
    "game:build": "npm run build -w @keepfall/game",
    "check:browser": "node tools/browser-hash.mjs",
    "observe": "node tools/observatory.mjs",
    "observe:quick": "node tools/observatory.mjs preset=quick"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "rolldown": "1.2.16",
    "typescript": "7.0.2"
  }
}
